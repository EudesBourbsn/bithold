if [ -n "${CI_PRIMARY_REPOSITORY_PATH:-}" ] && [ -r "$CI_PRIMARY_REPOSITORY_PATH/ios/.xcode.env.local" ]; then
  . "$CI_PRIMARY_REPOSITORY_PATH/ios/.xcode.env.local"
fi
if [ -z "${NODE_BINARY:-}" ] || [ ! -x "$NODE_BINARY" ]; then
  NODE_BINARY="$(command -v node || true)"
fi
if [ -z "$NODE_BINARY" ] || [ ! -x "$NODE_BINARY" ]; then
  NODE_BINARY="$("${SHELL:-/bin/zsh}" -lc 'command -v node' 2>/dev/null || true)"
fi
export NODE_BINARY
